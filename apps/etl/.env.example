# Azure Blob Storage
AZURE_STORAGE_ACCOUNT_NAME=your_storage_account
AZURE_STORAGE_CONTAINER_NAME=bankql-datasets

# Optional: override temp directory (default: /tmp/etl)
# ETL_TMP_DIR=/tmp/etl

# Azure credential env vars (used by DefaultAzureCredential)
# For local dev, run: az login
# For CI/CD, set AZURE_CLIENT_ID, AZURE_TENANT_ID, AZURE_CLIENT_SECRET
# or use AZURE_FEDERATED_TOKEN_FILE for workload identity
